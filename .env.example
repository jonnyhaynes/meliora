# Postgres connection string. Docker Compose in this repo exposes the dev database
# on localhost:55432 (user/password/db all "meliora"). In production this is your
# Neon / Supabase / Railway pooled connection string.
DATABASE_URL=postgres://meliora:meliora@127.0.0.1:55432/meliora

# A long, unguessable string used to sign sessions and tokens.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Canonical origin, used for absolute URLs in metadata, sitemap and emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Outgoing email. Leave SMTP_HOST unset in development and Payload will
# use ethereal.email, logging a preview link to the console instead of sending.
EMAIL_FROM_ADDRESS=info@meliora.uk
EMAIL_FROM_NAME=Meliora Kitchens, Bedrooms & Bathrooms
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Where enquiry and booking notifications are delivered.
ENQUIRY_NOTIFICATION_EMAIL=info@meliora.uk

# Google reviews (Places API). Server-side only — never prefix with NEXT_PUBLIC_.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Cloudflare R2 media storage. Unset in development so uploads use local disk.
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=
